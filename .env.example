# Lavender Dashboard — Environment Configuration
# Copy this file to .env and adjust values for your deployment.
# Never commit your real .env file.

# ─── Server ──────────────────────────────────────────────────────────────────
# Listening host (default: 0.0.0.0)
# LAVENDER_HOST=0.0.0.0

# Listening port (default: 8080)
# LAVENDER_PORT=8080

# Enable developer mode: pre-seeds a local session so localhost can skip login.
# WARNING: Never set this in production.
# LAVENDER_DEBUG=false

# ─── Security ────────────────────────────────────────────────────────────────
# Secret key for signing session cookies.
# OPTIONAL: Lavender manages secrets autonomously (auto-generates and persists
# to ~/.config/lavender/secret.key on first run with 0600 permissions, with zero user action).
# Only set this if running multiple instances behind a load balancer that share session state.
# LAVENDER_SECRET_KEY=<generate with: python3 -c "import secrets; print(secrets.token_hex(32))">

# Comma-separated list of allowed CORS origins.
# Leave empty for same-origin only (recommended for production).
# LAVENDER_CORS_ORIGINS=http://localhost:3000

# ─── Auth & Navigation ────────────────────────────────────────────────────────
# PAM service name used for Linux authentication (default: login).
# PAM_SERVICE=login

# Require authentication to view the homepage and live telemetry stream.
# When false (default): homepage is public for viewing read-only hardware telemetry.
# When true: homepage is locked and requires login like all other routes.
# LAVENDER_REQUIRE_AUTH_FOR_HOMEPAGE=false
