# RN7 Linux Dashboard — Environment Variables
# Copy this to .env and fill in your values

# Dashboard configuration
PORT=8080
HOST=0.0.0.0
DEBUG=false

# Hermes paths (used by dashboard to interact with Hermes)
HERMES_BIN=/home/rahat/.local/bin/hermes
HERMES_HOME=/home/rahat/.hermes
HERMES_CRON_DIR=/home/rahat/.hermes/cron
HERMES_STATE_DB=/home/rahat/.hermes/state.db

# Hermes Bot Configuration
HERMES_BOT_TOKEN=
HERMES_APP_ID=
HERMES_VERIFIER=
HERMES_BOT_USERNAME=
HERMES_GROUP_ID=
HERMES_USER_CHAT_ID=
HERMES_OWNER_CHAT_ID=
HERMES_DB_PATH=

# External API keys (if needed)
OPENROUTER_API_KEY=
